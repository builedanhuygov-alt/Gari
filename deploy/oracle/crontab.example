# ==============================================================================
# GARI AgriTech AI Lab — Oracle Cloud Production Crontab
# Path: deploy/oracle/crontab.example
# Install via: crontab -e  (or: crontab deploy/oracle/crontab.example)
# ==============================================================================

# 1. Automated SQLite Online WAL-Safe Backup (Daily at 02:00 UTC)
# Retains 7 daily, 4 weekly, 3 monthly backups
0 2 * * * /usr/bin/docker exec gari-backend python deploy/oracle/backup_sqlite.py >> /var/log/gari_backup.log 2>&1

# 2. System Metrics & Observability Collector (Every 5 minutes)
*/5 * * * * bash /home/ubuntu/leaf-diseases-detector/deploy/oracle/system_metrics.sh >> /var/log/gari_metrics.log 2>&1

# 3. Let's Encrypt SSL Certificate Renewal Check (Daily at 03:30 UTC)
30 3 * * * certbot renew --webroot -w /var/www/certbot --quiet && docker exec gari-nginx nginx -s reload >> /var/log/gari_certbot.log 2>&1

