{
  "version": 2,
  "regions": ["sin1"],
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "public": false,
  "functions": {
    "api/index.py": {
      "includeFiles": "auth-server/**",
      "maxDuration": 30
    },
    "api/[...path].js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(self)"
        }
      ]
    },
    {
      "source": "/frontend2/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/static/frontend2/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/frontend2/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/v1/auth/(.*)",
      "destination": "/api"
    },
    {
      "source": "/api/v1/auth",
      "destination": "/api"
    },
    {
      "source": "/api/auth/(.*)",
      "destination": "/api"
    },
    {
      "source": "/api/auth",
      "destination": "/api"
    },
    {
      "source": "/api/v1/health",
      "destination": "/api"
    },
    {
      "source": "/api/health",
      "destination": "/api"
    },
    {
      "source": "/api/v1/ready",
      "destination": "/api"
    },
    {
      "source": "/api/ready",
      "destination": "/api"
    },
    {
      "source": "/api/v1/profile/(.*)",
      "destination": "/api"
    },
    {
      "source": "/api/v1/profile",
      "destination": "/api"
    },
    {
      "source": "/api/profile/(.*)",
      "destination": "/api"
    },
    {
      "source": "/api/profile",
      "destination": "/api"
    },
    {
      "source": "/api/v1/user/profile/(.*)",
      "destination": "/api"
    },
    {
      "source": "/api/user/profile/(.*)",
      "destination": "/api"
    },
    {
      "source": "/api/v1/admin/(.*)",
      "destination": "/api"
    },
    {
      "source": "/api/admin/(.*)",
      "destination": "/api"
    },
    {
      "source": "/api/v1/voucher/(.*)",
      "destination": "/api"
    },
    {
      "source": "/api/v1/voucher",
      "destination": "/api"
    },
    {
      "source": "/api/voucher/(.*)",
      "destination": "/api"
    },
    {
      "source": "/api/voucher",
      "destination": "/api"
    },
    {
      "source": "/api/predict/(.*)",
      "destination": "/api/[...path]?path=predict/$1"
    },
    {
      "source": "/api/predict",
      "destination": "/api/[...path]?path=predict"
    },
    {
      "source": "/api/diagnose/(.*)",
      "destination": "/api/[...path]?path=diagnose/$1"
    },
    {
      "source": "/api/diagnose",
      "destination": "/api/[...path]?path=diagnose"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/[...path]?path=$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/[...path]?path=uploads/$1"
    },
    {
      "source": "/static/frontend2/(.*)",
      "destination": "/frontend2/$1"
    },
    {
      "source": "/",
      "destination": "/frontend2"
    },
    {
      "source": "/frontend2",
      "destination": "/frontend2"
    },
    {
      "source": "/frontend2/",
      "destination": "/frontend2"
    },
    {
      "source": "/host",
      "destination": "/frontend2/host"
    },
    {
      "source": "/host-login",
      "destination": "/frontend2/host-login"
    },
    {
      "source": "/expert",
      "destination": "/frontend2/expert-portal"
    },
    {
      "source": "/login",
      "destination": "/frontend2/login"
    },
    {
      "source": "/register",
      "destination": "/frontend2/register"
    },
    {
      "source": "/forgot-password",
      "destination": "/frontend2/forgot-password"
    },
    {
      "source": "/predict",
      "destination": "/frontend2/predict"
    },
    {
      "source": "/crops",
      "destination": "/frontend2/crops"
    },
    {
      "source": "/farms",
      "destination": "/frontend2/farms"
    },
    {
      "source": "/calendar",
      "destination": "/frontend2/calendar"
    },
    {
      "source": "/risk",
      "destination": "/frontend2/risk"
    },
    {
      "source": "/reports",
      "destination": "/frontend2/reports"
    },
    {
      "source": "/organization",
      "destination": "/frontend2/organization"
    },
    {
      "source": "/pricing",
      "destination": "/frontend2/pricing"
    },
    {
      "source": "/support",
      "destination": "/frontend2/support"
    },
    {
      "source": "/settings",
      "destination": "/frontend2/settings"
    },
    {
      "source": "/community",
      "destination": "/frontend2/community"
    },
    {
      "source": "/admin/infrastructure",
      "destination": "/frontend2/admin-infrastructure"
    },
    {
      "source": "/admin",
      "destination": "/frontend2/admin"
    },
    {
      "source": "/api-docs",
      "destination": "/frontend2/api-docs"
    },
    {
      "source": "/terms-of-service",
      "destination": "/frontend2/terms-of-service"
    },
    {
      "source": "/privacy-policy",
      "destination": "/frontend2/privacy-policy"
    },
    {
      "source": "/refund-policy",
      "destination": "/frontend2/refund-policy"
    },
    {
      "source": "/cookie-policy",
      "destination": "/frontend2/cookie-policy"
    }
  ]
}
