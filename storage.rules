rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isHostAdmin() {
      return isAuthenticated() && request.auth.token.host_admin == true;
    }

    function isValidImage() {
      return request.resource.contentType.matches('image/.*')
             && request.resource.size < 15 * 1024 * 1024; // 15MB limit
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // User Profile Pictures: /users/{userId}/avatar/{fileName}
    match /users/{userId}/avatar/{fileName} {
      allow read: if true; // Publicly readable avatars
      allow write: if isOwner(userId) && isValidImage();
      allow delete: if isOwner(userId) || isHostAdmin();
    }

    // Organization Assets: /organizations/{orgId}/{fileName}
    match /organizations/{orgId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isValidImage();
      allow delete: if isHostAdmin();
    }

    // Farm Crop Diagnosis Uploads: /farms/{farmId}/diagnoses/{fileName}
    match /farms/{farmId}/diagnoses/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isValidImage();
      allow delete: if isHostAdmin();
    }
  }
}
