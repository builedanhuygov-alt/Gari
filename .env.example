# ==============================================================================
# GARI AI LAB — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to `.env` and configure appropriate values for your environment.
# NEVER commit the active `.env` file containing real credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Mode Selection
# ------------------------------------------------------------------------------
# Supported values: development | test | staging | production
APP_ENV=development

# Node environment – used by the server's production fail-closed guard.
# Must be set to 'production' to trigger startup rejection when ALLOWED_ORIGINS is empty.
# This variable is read directly from the process environment (not via dotenv).
NODE_ENV=development

# Server binding
GARI_HOST=0.0.0.0
GARI_PORT=8000

# Debug mode (Strictly forced to False in production)
DEBUG=false

# ------------------------------------------------------------------------------
# 2. Cryptographic Secrets (MANDATORY IN PRODUCTION)
# ------------------------------------------------------------------------------
# In production, these MUST be set to strong, cryptographically random strings (min 32 chars).
# Example command to generate: `openssl rand -hex 32`
# If left empty or using the default placeholder, the server will refuse to start in production.
SESSION_SECRET=YOUR_SECURE_RANDOM_SESSION_SECRET_MIN_32_CHARS
JWT_SECRET=YOUR_SECURE_RANDOM_JWT_SECRET_MIN_32_CHARS

# Password Hashing Rounds (OWASP Bcrypt recommended: 12)
BCRYPT_ROUNDS=12

# Session Expiration (Days)
SESSION_DURATION_DAYS=7
REMEMBER_ME_DAYS=30

# ------------------------------------------------------------------------------
# 3. Network Security & CORS Configuration
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins (exact-match, no wildcards).
# '*' is explicitly forbidden and will cause the server to refuse startup.
# Wildcard ('*') is strictly forbidden. Listing '*' in this variable causes
# the server to exit(1) at startup – even in development.
#
# IMPORTANT: This variable is read from the *process environment* only.
# It is NOT loaded via dotenv in the Node server. Set it in your shell, CI
# system, Docker Compose, or systemd unit before starting the server.
#
# Development example:
#   ALLOWED_ORIGINS=http://localhost:5173
# Staging/production example:
#   ALLOWED_ORIGINS=https://app.gari.ai,https://staging.gari.ai
#
# If NODE_ENV=production and this is empty, the server refuses to start.
ALLOWED_ORIGINS=http://localhost:5173

# Cookie Security flags (currently unused – app uses Bearer tokens)
COOKIE_SECURE=false  # Set to true in production behind HTTPS
COOKIE_SAMESITE=lax

# ------------------------------------------------------------------------------
# 4. Feature Flags & Development Safeguards
# ------------------------------------------------------------------------------
# Developer Pro Bypass allows simulating Pro entitlements via header 'X-Gari-Dev-Pro'.
# STRICTLY FORBIDDEN IN PRODUCTION: Automatically forced to false when APP_ENV=production.
GARI_ALLOW_DEV_PRO=0

# Rate Limiting Thresholds (In-Memory Protection)
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# ------------------------------------------------------------------------------
# 5. Database Persistence (SQLite)
# ------------------------------------------------------------------------------
# Local persistent SQLite database with WAL mode and foreign key constraints
DATABASE_URL=sqlite:///database/disease_detector.db

# ------------------------------------------------------------------------------
# 6. AI Inference & Model Storage
# ------------------------------------------------------------------------------
DEVICE=cpu
MODELS_DIR=models
MAX_CACHED_MODELS=3
MAX_UPLOAD_SIZE_BYTES=15728640  # 15 MB
INFERENCE_TIMEOUT_SECONDS=30

# ------------------------------------------------------------------------------
# 7. Optional SMTP Configuration (Leave empty for manual pilot follow-up)
# ------------------------------------------------------------------------------
# If left blank, Gari AI Lab records pilot requests directly in the internal admin
# triage dashboard and displays honest notices about manual team follow-up.
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@gari.vn

# ------------------------------------------------------------------------------
# 8. Bank QR Payment Configuration (VietQR / Manual Admin Review)
# ------------------------------------------------------------------------------
PAYMENT_PROVIDER=bank_qr

# Recipient Vietnamese Bank Account (VietQR NAPAS standard)
BANK_QR_BANK_ID=MB                           # Bank code (e.g. MB, VCB, TCB, ACB, TPB)
BANK_QR_ACCOUNT_NUMBER=your_account_number   # Recipient bank account number
BANK_QR_ACCOUNT_NAME=your_account_name       # Recipient account owner name (e.g. GARI AI LAB)

# Public Checkout Safety Switch (0 = disabled, 1 = enabled)
# Keep disabled (0) by default until bank account and pricing are configured.
PAYMENT_PUBLIC_CHECKOUT_ENABLED=0

# Order Expiration (minutes)
PAYMENT_ORDER_EXPIRY_MINUTES=15


