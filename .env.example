# ==============================================================================
# GARI AgriTech AI Lab — Production Environment Template
# Copy this file to .env on the Oracle Cloud VM: cp .env.example .env
# DO NOT COMMIT THE ACTUAL .env FILE TO GIT
# ==============================================================================

# Application Environment
APP_ENV=production
DEBUG=False
PORT=8000
HOST=0.0.0.0
DEVICE=cpu

# Security & Authentication (MANDATORY: Generate a strong 32+ char random string)
# Command to generate: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_a_secure_random_string_at_least_32_chars_long

# CORS Allowed Origins (Comma-separated)
# Restrict strictly to the production frontend domain
GARI_ALLOW_ORIGINS=https://gari-team.vercel.app

# AI Inference Engine Optimization & On-Demand Lifecycle
MAX_CACHED_MODELS=3
INFERENCE_TIMEOUT_SECONDS=30
MODEL_IDLE_TIMEOUT_SECONDS=300
MODEL_PRELOAD_ENABLED=false
MODEL_AUTO_UNLOAD_ENABLED=true

# Database Configuration (Leave empty for default persistent SQLite)
# SQLite path inside container: /app/database/disease_detector.db
DATABASE_URL=

# Supabase Hybrid Cloud Configuration (Sprint 1.7+ & Phase B)
# Frontend / Public Anon Credentials (Safe for client browsers)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Backend Only — NEVER expose to frontend or commit to version control
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Firebase Admin SDK Credentials (Optional for Dev, Recommended for Production Auth)
FIREBASE_PROJECT_ID=gari-agritech
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Storage & Uploads
UPLOAD_MAX_SIZE_MB=25
MAX_LOG_FILES=3
MAX_LOG_SIZE_MB=50
